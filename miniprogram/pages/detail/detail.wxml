<view class="page" wx:if="{{sp}}">
  <image wx:if="{{img}}" class="cover" src="{{img}}" mode="aspectFill" />
  <view class="cover-placeholder" wx:else>暂无图片</view>

  <view class="title">{{sp.name}}</view>
  <view class="muted desc">包含 {{variants.length}} 种不同个体</view>

  <view class="section-title">个体列表</view>
  <view class="variants">
    <view wx:for="{{variants}}" wx:key="id" class="variant">
      <text class="variant-name">{{item.name}}</text>
      <text class="variant-rarity">{{item.rarity || 'common'}}</text>
    </view>
  </view>
</view>
