.search { padding: 20rpx 24rpx; }
.search__input {
  background: #261646; border-radius: 999rpx; padding: 18rpx 32rpx; color: #fff; font-size: 28rpx;
}
.stats { padding: 0 32rpx 12rpx; font-size: 24rpx; }
.grid { display: flex; flex-wrap: wrap; padding: 8rpx 16rpx 40rpx; }
.sp-card {
  width: calc(50% - 24rpx); margin: 12rpx; background: #261646;
  border-radius: 20rpx; overflow: hidden;
}
.sp-img { width: 100%; height: 240rpx; background: #1b1030; }
.sp-name { padding: 16rpx 20rpx 4rpx; font-size: 30rpx; font-weight: 600; }
.sp-sub { padding: 0 20rpx 18rpx; font-size: 22rpx; }
