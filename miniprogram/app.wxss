page {
  background: #1b1030;
  color: #f3eefe;
  font-family: -apple-system, "PingFang SC", sans-serif;
}
view, text { box-sizing: border-box; }
.hero-title { font-size: 44rpx; font-weight: 700; }
.muted { color: #b9aed6; }
.card {
  background: #261646;
  border-radius: 20rpx;
  padding: 24rpx;
  margin: 16rpx;
}
.btn {
  background: #ffcf4d;
  color: #1b1030;
  font-weight: 700;
  border-radius: 999rpx;
  padding: 18rpx 40rpx;
  display: inline-block;
}
