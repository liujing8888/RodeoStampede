.cover { width: 100%; height: 420rpx; background: #1b1030; }
.cover-placeholder { width: 100%; height: 420rpx; background: #261646; display: flex; align-items: center; justify-content: center; color: #9a8fb5; }
.title { padding: 28rpx 32rpx 4rpx; font-size: 44rpx; font-weight: 800; }
.desc { padding: 0 32rpx 8rpx; font-size: 26rpx; }
.section-title { margin: 24rpx 32rpx 8rpx; font-size: 30rpx; font-weight: 700; }
.variants { padding: 0 24rpx 40rpx; }
.variant { display: flex; justify-content: space-between; align-items: center; background: #261646; border-radius: 16rpx; padding: 22rpx 28rpx; margin: 12rpx; }
.variant-name { font-size: 28rpx; }
.variant-rarity { font-size: 22rpx; color: #ffcf4d; text-transform: capitalize; }
